# Sidewalk environment. Copy to .env (run `pnpm env:init` to do it for you, with fresh secrets).
# One file feeds the API, Prisma and the web app. Never commit a real .env.

# ── General ─────────────────────────────────────────────────────────────────
NODE_ENV=development
# API listens here. The web app proxies /api/v1/* to it, so browsers only talk to the web origin.
API_PORT=4000
LOG_LEVEL=info
# Public origin of the web app. Used for CORS and the cross-site request origin check.
WEB_ORIGIN=http://localhost:3000
# Interface the API listens on. Loopback keeps it reachable only through the web app's proxy. Use 0.0.0.0
# only inside a private network or container, never on a public interface.
API_HOST=127.0.0.1
# Only for deployments where something *other than the web app* sits directly in front of the API (for example a
# load balancer that sets X-Forwarded-For): the number of trusted proxy hops. Leave at false in the standard layout.
# Never set it above 0 if the API port is reachable from the internet: clients could forge their address.
TRUST_PROXY=false
# Shared secret that lets the web app tell the API a visitor's real address (used for rate limits). The API
# ignores that address without this secret, so visitors cannot pick their own rate-limit bucket. Required in
# production. `pnpm env:init` generates one. The web app reads the same value.
INTERNAL_PROXY_SECRET=replace-me-run-pnpm-env-init
# Reverse proxies in front of the WEB app (TLS terminator, CDN, load balancer). The web app trusts the
# X-Forwarded-For entry appended by the nearest one of them. 1 is typical; use 0 only if you do not need
# per-visitor rate limits. Never run the web app directly on the internet with a value above 0.
WEB_TRUSTED_PROXY_HOPS=1

# ── Database (PostgreSQL) ───────────────────────────────────────────────────
# Matches docker-compose.yml. Port 5442 avoids clashing with a Postgres you may already run on 5432.
DATABASE_URL="postgresql://sidewalk:sidewalk_dev_only@127.0.0.1:5442/sidewalk?schema=public"

# ── Authentication ──────────────────────────────────────────────────────────
# At least 32 random characters. `pnpm env:init` generates one. Rotating it signs everyone out of access tokens.
JWT_ACCESS_SECRET=replace-me-run-pnpm-env-init
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Defaults to true in production, false otherwise. Must be true behind HTTPS.
# COOKIE_SECURE=true
# COOKIE_DOMAIN=
# Rate limits are counted in PostgreSQL, so they hold across API instances and survive restarts. Leave the
# multiplier at 1 except in automated tests (production refuses anything else).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MULTIPLIER=1
# How long a rate-limit check may wait for the database before that request is counted in this process's memory
# instead (limits keep applying during an outage, per instance). Raise it only if your database is far away.
# RATE_LIMIT_STORE_TIMEOUT_MS=750

# ── Evidence storage ────────────────────────────────────────────────────────
# "s3" works with AWS S3, Cloudflare R2, Backblaze B2, SeaweedFS, MinIO and other S3-compatible stores.
# "local" writes to LOCAL_STORAGE_DIR and is meant for quick development only.
STORAGE_DRIVER=s3
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_BUCKET=sidewalk-evidence
# The local SeaweedFS container accepts any credentials. Use real, least-privilege keys elsewhere.
S3_ACCESS_KEY_ID=sidewalk-dev
S3_SECRET_ACCESS_KEY=sidewalk-dev-secret
S3_FORCE_PATH_STYLE=true
LOCAL_STORAGE_DIR=.local-storage

# ── Email ───────────────────────────────────────────────────────────────────
# Verification, password-reset and notification email is sent through SMTP. In development, docker compose
# runs Mailpit, which captures every message (nothing is delivered): read them at http://localhost:8025.
# Links in emails are built from WEB_ORIGIN, never from a request header, so it must be your public https URL
# in production.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
EMAIL_FROM="Sidewalk <no-reply@sidewalk.test>"
# Delivery runs in a worker. By default it runs inside the API process. To run it separately (recommended when
# you run several API instances, which is safe because workers claim rows with SKIP LOCKED), set this to false in
# the API and start `pnpm worker`.
OUTBOX_WORKER_ENABLED=true
OUTBOX_POLL_MS=2000
# Keys that encrypt queued email content (a message can hold a one-time link until it is sent). Comma-separated
# `id:base64` entries of 32 random bytes; the FIRST encrypts, the rest only decrypt (so rotating never strands a
# queued message). Independent of JWT_ACCESS_SECRET. Required in production. `pnpm env:init` fills this in for a new
# .env; generate more with `pnpm outbox:keys generate`. Rotation and backup: docs/operations.md.
OUTBOX_ENCRYPTION_KEYS=replace-me-run-pnpm-env-init
# Whether messages queued before these keys existed (encrypted with a JWT-derived key) can still be read. Turn
# off once `pnpm outbox:keys status` shows no `legacy` rows.
OUTBOX_LEGACY_JWT_DECRYPT=true
# Host ports docker compose uses for Mailpit (SMTP and the inbox UI). If you change MAILPIT_SMTP_PORT, change
# SMTP_PORT above to match.
# MAILPIT_SMTP_PORT=1025
# MAILPIT_UI_PORT=8025

# ── Location search (geocoding) ─────────────────────────────────────────────
# "nominatim" (OpenStreetMap) or "none" to disable search and rely on map pin / manual coordinates.
# The public nominatim.openstreetmap.org server is for light development use only (1 request per second,
# identifying contact required) and is rejected in production. Run your own instance or use a commercial provider.
GEOCODER_PROVIDER=nominatim
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
GEOCODER_CONTACT=you@example.com
GEOCODER_COUNTRY_CODES=ng

# ── Web app ─────────────────────────────────────────────────────────────────
# Where the Next.js server reaches the API (server-to-server).
API_INTERNAL_URL=http://127.0.0.1:4000
# Canonical public URL, used for share links and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Raster tile template for MapLibre. The default is OpenStreetMap's public tile server, which is
# fine for development but not for production traffic: https://operations.osmfoundation.org/policies/tiles/
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION="© OpenStreetMap contributors"

# ── Seeding (development only; the seed refuses to run in production) ──────
# Leave blank to have `pnpm db:seed` generate a random password and print it once.
SEED_PASSWORD=
