# Non-secret values used by automated tests. Safe to commit: they only reach throwaway databases.
NODE_ENV=test
API_PORT=4010
LOG_LEVEL=silent
WEB_ORIGIN=http://localhost:3010
DATABASE_URL="postgresql://sidewalk:sidewalk_dev_only@127.0.0.1:5442/sidewalk_test?schema=public"
JWT_ACCESS_SECRET=test-only-secret-not-for-real-use-0123456789abcdef
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MULTIPLIER=1
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.local-storage/test
GEOCODER_PROVIDER=none
SEED_PASSWORD=Test-only-password-1
