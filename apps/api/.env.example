# ==============================================================================
# Sidewalk API - Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust values for your local environment:
#   cp .env.example .env

# ------------------------------------------------------------------------------
# Database Settings
# ------------------------------------------------------------------------------
# Async database connection URL.
# PostgreSQL format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
# SQLite (testing/local): sqlite+aiosqlite:///./sidewalk.db
# Docker Compose default:
DATABASE_URL=postgresql+asyncpg://sidewalk:sidewalk@localhost:5432/sidewalk_dev

# Connection pool sizing (PostgreSQL only; ignored by SQLite)
# DB_POOL_SIZE: Base number of persistent connections to keep in the pool (e.g. 5, 10, 20)
DB_POOL_SIZE=10
# DB_MAX_OVERFLOW: Extra connections allowed beyond DB_POOL_SIZE during spikes (e.g. 10, 20)
DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT: Seconds to wait for a connection before timing out (e.g. 30)
DB_POOL_TIMEOUT=30

# ------------------------------------------------------------------------------
# Security & Authentication
# ------------------------------------------------------------------------------
# Secret key used for signing JWT access tokens. Must be a long random string in production (>= 32 chars).
# Generate one using: openssl rand -hex 32
SECRET_KEY=default-dev-secret-key-change-in-production-min-32-chars

# JWT cryptographic signing algorithm. Typical values: HS256, RS256
JWT_ALGORITHM=HS256

# JWT token expiration in minutes. Default: 1440 (24 hours)
JWT_EXPIRES_MINUTES=1440

# Brute-force protection: Max failed login attempts before temporary account lockout
LOGIN_MAX_ATTEMPTS=5

# Duration of account lockout in minutes after exceeding LOGIN_MAX_ATTEMPTS
LOGIN_LOCKOUT_MINUTES=15

# ------------------------------------------------------------------------------
# Server & Logging
# ------------------------------------------------------------------------------
# Runtime environment: development | staging | production
ENVIRONMENT=development

# API version string returned in system metadata and OpenAPI schema
API_VERSION=0.1.0

# Allowed CORS origins as a JSON-encoded list of origin URLs
CORS_ORIGINS=["http://localhost:3000","http://localhost:8081"]

# Structured logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Rate Limiting (slowapi)
# ------------------------------------------------------------------------------
# Global default rate limit per IP for general API endpoints (e.g. "200/minute", "1000/hour")
RATE_LIMIT_DEFAULT=200/minute

# Stricter rate limit applied to authentication/login endpoints (e.g. "10/minute", "5/minute")
RATE_LIMIT_LOGIN=10/minute
