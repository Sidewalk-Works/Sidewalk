{
  "name": "@sidewalk/api",
  "version": "0.1.0",
  "private": true,
  "description": "Sidewalk REST API (NestJS modular monolith).",
  "scripts": {
    "dev": "nest start --watch",
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "jest --runInBand",
    "test:cov": "jest --runInBand --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force --skip-seed && tsx prisma/seed.ts",
    "db:truncate-test": "tsx scripts/truncate-test-db.ts",
    "build:e2e": "prisma generate && tsc -p tsconfig.build.json --outDir dist-e2e",
    "start:e2e": "node dist-e2e/main.js",
    "admin:promote": "tsx scripts/promote-admin.ts",
    "storage:reconcile": "tsx scripts/reconcile-storage.ts",
    "outbox:keys": "tsx scripts/outbox-keys.ts",
    "account:upgrade": "tsx scripts/account-upgrade.ts",
    "ops:check": "tsx scripts/ops-check.ts",
    "ops:drill": "tsx scripts/worker-recovery-drill.ts",
    "ops:prodlike": "tsx scripts/prodlike-verify.ts",
    "worker": "node dist/worker.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@sidewalk/contracts": "workspace:*",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "nestjs-pino": "^4.6.1",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.8",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.19.1",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "jest": "^30.2.0",
    "pino-pretty": "^13.1.2",
    "prisma": "^7.10.1",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4"
  }
}
