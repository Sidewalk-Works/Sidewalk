# apps/api/.env.example
# ==========================================
# Sidewalk API Environment Configuration
# ==========================================

# --- Required Fields (No defaults) ---
# PostgreSQL connection URL (e.g., postgresql://user:password@localhost:5432/db)
DATABASE_URL=postgresql://sidewalk_user:sidewalk_password@localhost:5432/sidewalk_dev?schema=public

# Cryptographic secret key used for signing JWTs and session tokens
SECRET_KEY=super-secret-production-key-change-me-in-production

# --- Optional Fields (With defaults) ---
# Application runtime environment: development, staging, production
ENVIRONMENT=development

# API version prefix descriptor
API_VERSION=0.1.0

# Comma-separated list of allowed CORS origins for web and mobile frontends
CORS_ORIGINS=["http://localhost:3000","http://localhost:8081"]

# JWT signing algorithm
JWT_ALGORITHM=HS256

# JWT token expiration time in minutes (default: 24 hours)
JWT_EXPIRES_MINUTES=1440

# Maximum failed login attempts before temporary account lockout
LOGIN_MAX_ATTEMPTS=5

# Account lockout duration in minutes following max failed login attempts
LOGIN_LOCKOUT_MINUTES=15

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO