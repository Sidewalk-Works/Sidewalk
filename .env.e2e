# Non-secret values used by Playwright end-to-end runs against a real API, web server and database.
NODE_ENV=test
API_PORT=4020
LOG_LEVEL=warn
WEB_ORIGIN=http://localhost:3020
TRUST_PROXY=false
INTERNAL_PROXY_SECRET=e2e-only-internal-secret-0123456789abcdef-xyz
WEB_TRUSTED_PROXY_HOPS=1
DATABASE_URL="postgresql://sidewalk:sidewalk_dev_only@127.0.0.1:5442/sidewalk_e2e?schema=public"
JWT_ACCESS_SECRET=e2e-only-secret-not-for-real-use-0123456789abcdef
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MULTIPLIER=100
SWAGGER_ENABLED=false
STORAGE_DRIVER=s3
S3_ENDPOINT=http://127.0.0.1:8333
S3_BUCKET=sidewalk-e2e
S3_ACCESS_KEY_ID=sidewalk-dev
S3_SECRET_ACCESS_KEY=sidewalk-dev-secret
GEOCODER_PROVIDER=none
API_INTERNAL_URL=http://127.0.0.1:4020
NEXT_PUBLIC_SITE_URL=http://localhost:3020
SEED_PASSWORD=E2e-only-password-1
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
EMAIL_FROM="Sidewalk <no-reply@sidewalk.test>"
OUTBOX_POLL_MS=300
# Throwaway key for this disposable environment only (not a secret).
OUTBOX_ENCRYPTION_KEYS=te2e:wxPtcDqk0NjeWv8tg01JwwwDMfCydUaW1YMMN5msIdQ=
